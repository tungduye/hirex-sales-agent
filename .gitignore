# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright/.auth/
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/runtime/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local process logs (may contain contact names)
*.log

# build outputs kept on the host for rollback by deploy-recruiter-tone.ps1
/.next-*/

# local working folders: ad-hoc scripts, QA captures, exported drafts
/tmp/
/outputs/

# AccountsHS Python sources (API keys, Facebook debug dumps): kept on this computer, never pushed
moduleHS/accountshs/_src_python/
